APP_NAME=AgentGCS Backend
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|192\\.168\\.\\d+\\.\\d+|10\\.\\d+\\.\\d+\\.\\d+|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d+\\.\\d+)(:\\d+)?$

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 32-byte key encoded in urlsafe base64.
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=REPLACE_ME

# Optional for live model inference. If empty, mock mode still works.
CLAUDE_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=
SCHOOL_API_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_DRIVE_INPUT_ROOT_FOLDER_ID=
GOOGLE_DRIVE_OUTPUT_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
